{
  "name": "farmacia-pos-api",
  "version": "1.0.0",
  "description": "API para farmacias: productos con lotes, vencimientos, ventas y roles",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node scripts/seed.js",
    "test": "jest"
  },
  "keywords": [
    "farmacia",
    "pos",
    "inventario",
    "express"
  ],
  "author": "Angel Emanuel Lecaro Quispe",
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ]
  },
  "engines": {
    "node": ">=20"
  }
